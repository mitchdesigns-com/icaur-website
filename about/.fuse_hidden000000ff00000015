<body class="is-loading">

<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
  <filter id="grain-filter" x="0%" y="0%" width="100%" height="100%">
    <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="4" stitchTiles="stitch" result="noise"/>
    <feColorMatrix type="saturate" values="0" in="noise" result="grey"/>
    <feBlend in="SourceGraphic" in2="grey" mode="multiply"/>
  </filter>
</svg>

<div class="cursor" id="cursor" aria-hidden="true">
  <div class="cursor__dot" id="cursorDot"></div>
  <div class="cursor__ring" id="cursorRing"></div>
  <div class="cursor__label" id="cursorLabel"></div>
</div>



<div id="site-header"></div>

<main id="main">

<!-- ═══════ HERO — spotlight reveal (same as the service heroes) ═══════ -->
<section class="spot-hero" id="hero">
  <div class="spot-hero__base" style="background-image:url('/assets/images/about-hero.jpg')" aria-hidden="true"></div>
  <div class="spot-hero__reveal" style="background-image:url('/assets/images/about-hero.jpg')" aria-hidden="true"></div>
  <div class="spot-hero__shade" aria-hidden="true"></div>

  <div class="spot-hero__head">
    <p class="eyebrow eyebrow--warm spot-anim spot-anim--fade" style="animation-delay:.1s">Our Story</p>
    <h1 class="spot-hero__h">
      <span class="spot-l1 spot-anim spot-anim--reveal" style="animation-delay:.25s">A New Generation</span>
      <span class="spot-l2 spot-anim spot-anim--reveal" style="animation-delay:.42s"><em>Automotive</em></span>
    </h1>
    <p class="spot-hero__sub spot-anim spot-anim--fade" style="animation-delay:.6s">Smarter mobility. Bolder design. Real-world freedom.</p>
  </div>
</section>

<!-- ═══════ PINNED SCENE — Overview ⇄ iCAUR Story ═══════ -->
<div class="about-scene" id="aboutScene">
  <div class="about-scene__pin">

    <!-- Story car — drives in from the left during Overview, then
         swings onto the rail and rotates to ride it down -->
    <img src="/assets/images/about-3d.png" alt="" class="story-scene-car" id="storySceneCar" aria-hidden="true">

    <div class="container about-scene__stage">

      <!-- Overview panel -->
      <div class="scene-panel scene-panel--overview" data-panel="overview">
        <div class="about-overview__inner">
          <p class="eyebrow">Overview</p>
          <h2 class="about-overview__h">The Future<br>Feels Different</h2>
          <p class="about-overview__lead">iCAUR is a new generation automotive brand redefining intelligent mobility through bold design, advanced technology, and expressive driving experiences. Built for the young and young-at-heart, iCAUR combines rugged character, smart innovation, and lifestyle-driven thinking to create vehicles that feel as exciting as they look.</p>
          <a href="/reserve" class="btn btn--dark btn--arrow btn--magnetic">Get Your iCAUR <span class="arrow">→</span></a>
        </div>
      </div>

      <!-- Story panel — car rides the rail, images stack on the right -->
      <div class="scene-panel scene-panel--story" data-panel="story">

        <!-- Left rail: gray line, passed area turns orange -->
        <div class="story-rail" aria-hidden="true">
          <div class="story-rail__line">
            <div class="story-rail__fill" id="storyRailFill"></div>
          </div>
        </div>

        <div class="about-saga__inner">
        <p class="eyebrow">iCAUR Story</p>
        <div class="about-saga__steps">
          <div class="saga-step is-active" data-step="0">
            <p>Born to break the mold — rugged character, smart tech, and lifestyle-first thinking in EVs that feel as exciting as they look.</p>
          </div>
          <div class="saga-step" data-step="1">
            <p>Engineered for Egypt: the heat, the dust, the drama. From Cairo traffic to the dunes, built to last and born to turn heads.</p>
          </div>
        </div>
        </div>

        <!-- Right: images pile over each other as the car drives down -->
        <div class="story-stack" aria-hidden="true">
          <img src="/assets/images/about-hero.jpg" class="story-stack__img" style="--r:-5deg; --x:-14px; --y:-10px" loading="lazy" alt="">
          <img src="/assets/images/iCAUR INTL_V27 REV_cam027 copy.jpg" class="story-stack__img" style="--r:4deg; --x:12px; --y:6px" loading="lazy" alt="">
          <img src="/assets/images/ICUAR V27 brochure 03 18.png" class="story-stack__img" style="--r:-2deg; --x:-4px; --y:12px" loading="lazy" alt="">
        </div>

      </div>

    </div>
  </div>
</div>

<!-- ═══════ BRAND FIGURES ═══════ -->
<section class="section about-figures" id="figures" data-dotfield>
  <div class="container">
    <div class="figures-grid">
      <div class="figure reveal reveal--up" data-delay="0">
        <span class="figure__num" data-count-to="200" data-suffix="+">0</span>
        <span class="figure__label">Engineers &amp; Designers</span>
        <span class="figure__sub">All based in Egypt, building for Egypt.</span>
      </div>
      <div class="figure reveal reveal--up" data-delay="1">
        <span class="figure__num" data-count-to="3" data-suffix="+">0</span>
        <span class="figure__label">Years of R&amp;D</span>
        <span class="figure__sub">Prototyping and testing on real roads.</span>
      </div>
      <div class="figure reveal reveal--up" data-delay="2">
        <span class="figure__num" data-count-to="2">0</span>
        <span class="figure__label">Groundbreaking Models</span>
        <span class="figure__sub">V27 and O3T — two distinct personalities.</span>
      </div>
      <div class="figure reveal reveal--up" data-delay="3">
        <span class="figure__num" data-count-to="100" data-suffix="%">0</span>
        <span class="figure__label">Made in Egypt</span>
        <span class="figure__sub">Designed, engineered, and assembled locally.</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BRAND VALUES — interactive (client A1) ═══════ -->
<section class="section usp-list usp-list--dark" id="values">
  <div class="container usp-list__wrap">
    <p class="eyebrow eyebrow--warm reveal reveal--up">What We Stand For</p>
    <h2 class="section-title section-title--light reveal reveal--up" data-delay="1">Built <em>Different.</em> On Purpose.</h2>

    <div class="usp-list__stack" id="uspStack">
      <div class="usp-row" tabindex="0" data-img="/assets/images/v27/v27-01.png">
        <span class="usp-row__title">Bold</span>
        <span class="usp-row__tag">Designed to stand out &mdash; and stay unforgettable.</span>
      </div>
      <div class="usp-row" tabindex="0" data-img="/assets/images/v27/interior-display.jpg">
        <span class="usp-row__title">Fun</span>
        <span class="usp-row__tag">Driving should feel like play, every time.</span>
      </div>
      <div class="usp-row" tabindex="0" data-img="/assets/images/v27/v27-26.png">
        <span class="usp-row__title">Daring</span>
        <span class="usp-row__tag">We take the roads others avoid.</span>
      </div>
      <div class="usp-row" tabindex="0" data-img="/assets/images/about-hero.jpg">
        <span class="usp-row__title">Liberating</span>
        <span class="usp-row__tag">Electric freedom &mdash; no permission needed.</span>
      </div>
    </div>

    <!-- Hover image preview — floats over the left side -->
    <div class="usp-preview" id="uspPreview" aria-hidden="true">
      <img src="" alt="">
    </div>
  </div>
</section>

<!-- ═══════ OUR MISSION — carousel ═══════ -->
<div class="diff-scroll-driver" id="missionDriver">
<section class="section diff mission-diff" id="missionSection">

  <div class="diff__curve" aria-hidden="true">
    <svg viewBox="0 0 1440 140" preserveAspectRatio="none"><path d="M0,100 C360,0 1080,0 1440,100 L1440,140 L0,140 Z"/></svg>
  </div>

  <div class="diff__glow diff__glow--1" aria-hidden="true"></div>
  <div class="diff__glow diff__glow--2" aria-hidden="true"></div>

  <!-- floating parallax images drifting around the statement -->
  <div class="mission-floats" aria-hidden="true">
    <div class="mission-float" data-depth="0.05" style="top:6%;left:4%;width:clamp(160px,18vw,280px)"><div class="mission-float__inner"><img src="/assets/images/ICUAR V27 brochure 03 18.png" alt=""></div></div>
    <div class="mission-float" data-depth="0.12" style="top:52%;left:5%;width:clamp(140px,16vw,250px)"><div class="mission-float__inner"><img src="/assets/images/ICUAR V27 brochure 03 23.webp" alt=""></div></div>
    <div class="mission-float" data-depth="0.07" style="top:6%;right:4%;width:clamp(150px,17vw,270px)"><div class="mission-float__inner"><img src="/assets/images/iCAUR INTL_V27 REV_cam027 copy.jpg" alt=""></div></div>
    <div class="mission-float" data-depth="0.14" style="top:52%;right:5%;width:clamp(140px,16vw,250px)"><div class="mission-float__inner"><img src="/assets/images/ICUAR V27 brochure 03 20.png" alt=""></div></div>
  </div>

  <div class="diff__viewport">
  <div class="diff__stage" id="missionStage">
    <div class="diff__panel diff__panel--intro" id="missionIntro">
      <div class="diff__intro-content">
        <h2 class="diff__headline mission-headline">Our <em>Mission</em></h2>
      </div>
    </div>

    <div class="diff__panel mission-statement">
      <p class="mission-statement__text">We exist to put Egypt on the global EV map — engineering world-class electric vehicles at home, for the heat, the highways, and the people who drive them. <em>Mobility, reimagined for real life.</em></p>
    </div>
  </div>
  </div>

</section>
</div>

<!-- ═══════ OUR VISION ═══════ -->
<div class="vision-driver" id="visionDriver">
<section class="vision" id="vision">

  <span class="vision__dash" aria-hidden="true"></span>
  <h2 class="vision__title">Our <em>Vision</em></h2>

  <div class="vision__img-stage">
    <div class="vision__img-wrap" id="visionImgWrap">
      <img src="/assets/images/about-hero.jpg" alt="iCAUR Vision" class="vision__img" loading="lazy">
    </div>
  </div>

  <div class="vision__body">
    <p class="vision__statement" id="visionStatement">To put Egypt on the global stage of electric mobility — engineering vehicles that don't just compete with the world's best, but define what's next for an entire generation.</p>
  </div>

</section>
</div>

<!-- ═══════ CTA ═══════ -->
<section class="cta-video" id="cta">
  <video class="cta-video__bg" src="/assets/images/CTA-bg.mp4" poster="/assets/images/CTA.jpg" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
  <div class="cta-video__overlay" aria-hidden="true"></div>
  <div class="cta-video__glass reveal reveal--up">
    <span class="cta-video__dash" aria-hidden="true"></span>
    <h2 class="cta-video__h">Ready For The <em>Next Step</em></h2>
    <p class="cta-video__body">The V27 is waiting — let's get you behind the wheel and show you what electric really means.</p>
    <div class="cta-video__actions">
      <a href="/reserve" class="btn btn--filled btn--lg btn--arrow btn--magnetic">Reserve Your iCAUR <span class="arrow">→</span></a>
      <a href="/contact" class="btn btn--outline btn--arrow btn--magnetic">Contact Us <span class="arrow">→</span></a>
    </div>
  </div>
</section>

</main>

