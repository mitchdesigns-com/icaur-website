  <meta name="description" content="About iCAUR — Egypt's next-generation EV company. Our story, mission, and values.">
  <title>About — iCAUR</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100..900&family=Noto+Kufi+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <script
  src="https://feedback-widget.mitchdesigns.workers.dev/widget.js"
  data-ingest-key="pk_45fe8548cf2370887b3de70a9d752080"
  data-endpoint="https://bugger-worker.mitchdesigns.workers.dev/functions/v1/ingest-feedback"
  data-position="bottom-right"
  data-button-text="Feedback"
  data-accent="#4f46e5"
  async></script>
